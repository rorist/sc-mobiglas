{
  "name": "sc-mobiglas",
  "author": "Rorist",
  "version": "0.1.0",
  "description": "SC mobiGlas is a fan-made watchface for Pebble PT2, inspired by Star Citizen's holographic interface. Display time, weather, health data, battery, and customizable manufacturer logos. This is an unofficial fan project, not affiliated with Cloud Imperium Games.",
  "license": "MIT",
  "keywords": [
    "pebble-app",
    "watchface",
    "star-citizen",
    "pebble-pt2",
    "mobiglas",
    "science fiction",
    "space"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.1.0"
  },
  "pebble": {
    "displayName": "SC mobiGlas",
    "uuid": "f9f0f305-ec71-473d-8e07-799225d4d099",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "capabilities": [
      "health",
      "configurable"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": {
      "KEY_TEMP": 0,
      "KEY_WEATHER": 1,
      "KEY_12H": 5,
      "KEY_FAHRENHEIT": 6,
      "KEY_SHOW_MEDICAL": 7,
      "KEY_SHOW_ENVIRON": 8,
      "KEY_SHOW_SYSTEMS": 9,
      "KEY_WIND_SPEED": 10,
      "KEY_WIND_DIR": 11,
      "KEY_HUMIDITY": 12,
      "KEY_UV": 13,
      "KEY_SUNRISE": 14,
      "KEY_SUNSET": 15,
      "KEY_LOGO": 16,
      "KEY_COLOR_TIME": 17,
      "KEY_COLOR_VALUE": 18,
      "KEY_COLOR_LABEL": 19,
      "KEY_COLOR_HEADER": 20,
      "KEY_COLOR_WARN": 21
    },
    "resources": {
      "media": [
        {
          "type": "png",
          "name": "IMAGE_MENU_ICON",
          "file": "images/app_icon.png"
        },
        {
          "type": "font",
          "name": "FONT_RAJDHANI_14",
          "file": "fonts/rajdhani-medium.ttf",
          "characterRegex": "[0-9:A-Za-z /.%°-]"
        },
        {
          "type": "font",
          "name": "FONT_RAJDHANI_18",
          "file": "fonts/rajdhani-medium.ttf",
          "characterRegex": "[0-9:A-Za-z /.%°-]"
        },
        {
          "type": "font",
          "name": "FONT_RAJDHANI_48",
          "file": "fonts/rajdhani-medium.ttf",
          "characterRegex": "[0-9: ]"
        },
        {
          "type": "font",
          "name": "FONT_RAJDHANI_56",
          "file": "fonts/rajdhani-medium.ttf",
          "characterRegex": "[0-9: ]"
        },
        {
          "type": "bitmap",
          "name": "IMAGE_LOGO_AEGIS",
          "file": "images/logo_aegis.png"
        },
        {
          "type": "bitmap",
          "name": "IMAGE_LOGO_ANVIL",
          "file": "images/logo_anvil.png"
        },
        {
          "type": "bitmap",
          "name": "IMAGE_LOGO_CRUSADER",
          "file": "images/logo_crusader.png"
        },
        {
          "type": "bitmap",
          "name": "IMAGE_LOGO_RSI",
          "file": "images/logo_rsi.png"
        },
        {
          "type": "bitmap",
          "name": "IMAGE_LOGO_DRAKE",
          "file": "images/logo_drake.png"
        },
        {
          "type": "bitmap",
          "name": "IMAGE_LOGO_ORIGIN",
          "file": "images/logo_origin.png"
        },
        {
          "type": "bitmap",
          "name": "IMAGE_LOGO_STARCITIZEN",
          "file": "images/logo_starcitizen.png"
        },
        {
          "type": "bitmap",
          "name": "IMAGE_LOGO_FRONTIER",
          "file": "images/logo_frontier.png"
        },
        {
          "type": "bitmap",
          "name": "IMAGE_LOGO_HEADHUNTERS",
          "file": "images/logo_headhunters.png"
        }
      ]
    }
  }
}
